# load the scripting addition
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# layout
yabai -m config layout bsp \
                auto_balance off \
                window_placement second_child

# padding
yabai -m config top_padding 5 \
                bottom_padding 0 \
                left_padding 0 \
                right_padding 0 \
                window_gap 0

yabai -m config external_bar all:30:0

# mouse setiings
# - mouse_action1 - left click + drag
# - mouse_action2 - right click + drag
yabai -m config mouse_follows_focus off \
                mouse_modifier alt \
                mouse_drop_action swap \
                mouse_action1 move \
                mouse_action2 resize

# Disable specific apps
yabai -m rule --add app="^(System Settings|Find My|System Information|Calendar|Activity Monitor|FaceTime|Screen Sharing|Calculator|Stickies|Pritunl)$" manage=off
